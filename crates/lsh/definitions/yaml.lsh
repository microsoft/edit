#[display_name = "YAML"]
#[path = "**/*.yaml"]
#[path = "**/*.yml"]
pub fn yaml() {
    if /\s+/ {
        // Leading whitespace
    }

    var indentation = off;

    loop {
        if /-\s+/ {
            // List item
        }
        if /\w+:(?:\s+|$)/ {
            // Key: (Value follows)
        }

        if /[|>][-+]?.*/ {
            // If we see a multiline string inducer, capture content until indentation is back to before.
            // Since we'll skip multiple lines, we need to use nested loops here.

            loop {
                // Wait for the next line in this multiline string.
                await input;

                // Skip leading whitespace
                if /\s+/ {
                }

                if off <= indentation {
                    // Once the new indentation is smaller, the multiline string has ended.
                    break;
                }

                if /.*/ {
                    yield string;
                }
            }
        } else {
            break;
        }
    }

    yield other;

    if /---/ {
        yield other;
    } else if /!![\w-]+/ {
        // Explicit tag, e.g. !!str, !!int (see YAML 1.2.2 §6.9.1).
        yield storage.type;
        if /\s+/ {
            yield other;
        }
        if /'/ {
            until /$/ {
                yield string;
                if /''/ {
                } else if /'/ {
                    yield string;
                    break;
                }
                await input;
            }
        } else if /"/ {
            until /$/ {
                yield string;
                if /\\./ {
                } else if /"/ {
                    yield string;
                    break;
                }
                await input;
            }
        } else if /true|false|yes|no|null|~/ {
            if /\s*[^\s#]+[^#]*/ {
                yield string;
            } else {
                yield constant.language;
            }
        } else if /(?i:[+-]?\.(?:inf|nan))\>/ {
            if /\s*[^\s#]+[^#]*/ {
                yield string;
            } else {
                yield constant.numeric;
            }
        } else if /-?(?:0x[\da-fA-F_]+|0o[0-7_]+|0b[01_]+|\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?/ {
            if /\s*[^\s#]+[^#]*/ {
                yield string;
            } else {
                yield constant.numeric;
            }
        } else if /[^\s#]+[^#]*/ {
            yield string;
        }
    } else if /'/ {
        // Single-quoted string. '' is an escaped quote (see YAML 1.2.2 §7.3.2).
        // Handled explicitly so that '#' inside quotes isn't mistaken for a comment.
        until /$/ {
            yield string;
            if /''/ {
                // Escaped quote, stay in string.
            } else if /'/ {
                yield string;
                break;
            }
            await input;
        }
    } else if /"/ {
        // Double-quoted string with backslash escapes.
        until /$/ {
            yield string;
            if /\\./ {
            } else if /"/ {
                yield string;
                break;
            }
            await input;
        }
    } else if /true|false|yes|no|null|~/ {
        // If it looks like a keyword, check if it's actually a string (e.g. "foo: true false").
        // TODO: Ideally this would not consume the last chunk of /\s+/ before a /# comment/.
        if /\s*[^\s#]+[^#]*/ {
            yield string;
        } else {
            yield constant.language;
        }
    } else if /(?i:[+-]?\.(?:inf|nan))\>/ {
        // Special values: .inf, -.inf, +.inf, .nan (see YAML 1.2.2 §2.4, Example 2.20).
        // Same as with keywords above: trailing content means it's actually a string.
        if /\s*[^\s#]+[^#]*/ {
            yield string;
        } else {
            yield constant.numeric;
        }
    } else if /-?(?:0x[\da-fA-F_]+|0o[0-7_]+|0b[01_]+|\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?/ {
        // Numbers, incl. hex/octal/binary (see YAML 1.2.2 §2.4, Example 2.19).
        // Same as with keywords above.
        if /\s*[^\s#]+[^#]*/ {
            yield string;
        } else {
            yield constant.numeric;
        }
    } else if /[^\s#]+[^#]*/ {
        // Same as before: Gobble anything that looks like a string.
        // TODO: This could be simplified & combined with the above if we stored the
        // highlight kind into a variable and then yield the variable value itself.
        yield string;
    }

    if /\s+/ {
        yield other;
    }

    if /#.*/ {
        yield comment;
    }
}
